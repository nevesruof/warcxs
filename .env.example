# Server-only settings. Never use a VITE_ prefix for secrets.
# Optional override; when blank, the site uses the existing activity bot.
# Use HTTPS for an authenticated replacement endpoint.
ACTIVITY_BOT_URL=
ACTIVITY_BOT_TOKEN=

# Enables search for embeddable YouTube videos and listening together.
YOUTUBE_API_KEY=

# Optional, only if Roblox does not expose the user's current experience publicly.
# Keep this in the hosting provider's secret settings, never in browser code.
ROBLOX_COOKIE=
