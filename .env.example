# Server-only settings. Never use a VITE_ prefix for secrets.
# Optional override; when blank, uses http://fi10.bot-hosting.cloud:26022/api/activity.
# Use HTTPS for an authenticated replacement endpoint.
ACTIVITY_BOT_URL=
# Must match API_TOKEN in the bot's .env. Sent whenever it is set (also with the default URL).
ACTIVITY_BOT_TOKEN=

# Reads current Discord avatar/banner directly (static or animated), once per minute.
# Without it, the public fallback has its own longer cache.
DISCORD_BOT_TOKEN=

# Enables search for embeddable YouTube videos and listening together.
YOUTUBE_API_KEY=

# Powers "OPEN DETAILS" on recent games (IGDB, via a free Twitch developer app).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Guestbook (button in the social rail). Create an Upstash Redis store in
# Vercel -> Storage and these two are added automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Long random string: signs delete links and hashes IPs. Required to accept posts.
GUESTBOOK_SECRET=
# Optional: Discord webhook that receives each new message with a delete link.
GUESTBOOK_WEBHOOK_URL=
# Optional: comma-separated words to reject.
GUESTBOOK_BLOCKED_WORDS=
